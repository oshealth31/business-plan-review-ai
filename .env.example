# Copy to .env (never commit it). In production the app refuses to start with weak secrets.
ENVIRONMENT=production
JWT_SECRET=                      # 32+ random characters: python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=                  # 12+ characters
DATABASE_URL=                    # postgresql+psycopg://user:pass@host/db  (empty = SQLite in DATA_DIR, demo only)
DATA_DIR=./data
CURRENCY=BWP
SUPPORT_EMAIL=
REQUIRE_INVITE=true
RETENTION_DAYS=30
QUICK_SCANS_PER_DAY=10
FULL_REPORTS_PER_DAY=10
TERMS_VERSION=draft-2026-10     # replace with your reviewed terms/privacy notice version
# Payments (provider-neutral): signed webhook + payment-link packs
PAYMENT_WEBHOOK_SECRET=
PACKS_JSON=[{"id":"pack10","name":"10 credits","credits":10,"price":"100","currency":"BWP","url":"https://pay.example.com/pack10"}]
# Optional AI notes (applicant must opt in for each report)
OPENAI_API_KEY=
OPENAI_MODEL=
AI_GLOBAL_DAILY_LIMIT=300
ALLOWED_ORIGINS=
